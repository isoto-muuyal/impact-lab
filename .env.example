NODE_ENV=production

# OpenTelemetry — Grafana Cloud (traces via hosted Tempo)
# Leave blank to disable trace export (metrics/Prometheus still active)
OTEL_SERVICE_NAME=impact-lab
GRAFANA_OTLP_ENDPOINT=https://<your-instance>.grafana.net/otlp
GRAFANA_INSTANCE_ID=
GRAFANA_API_TOKEN=
REDIS_URL=redis://localhost:6379
GEMINI_API_KEY=
GEMINI_EMBEDDING_MODEL=text-embedding-004
GEMINI_MODEL=gemini-1.5-pro
# MCP server used by the mentor profiling agent (shell command spawned via stdio).
# Production/QA run the built bundle; for local dev (npm run dev, no dist/ build) use:
# MCP_SERVER=tsx server/mcp/mentorProfilingMcpServer.ts
MCP_SERVER=node dist/mentorProfilingMcpServer.cjs
PORT=5000
DATABASE_URL=postgres://impactlab:impactlab@postgres_db:5432/impactlab?sslmode=disable
SESSION_SECRET=replace-with-a-long-random-string
MAILERSEND_API_KEY=
IMAGE_URI=
DOCKER_NETWORK=shared_network
